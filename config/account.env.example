# Example per-account env (same file jinghong systemd EnvironmentFile uses).
# Hyperion reads channels + HTTP port from this file. Secrets stay here too
# for jinghong; Hyperion only needs the JINGHONG_* routing keys.

# UI tab title (optional; default = filename stem or HYPERION_ID)
HYPERION_LABEL=Paper 3
# Optional stable id (default = filename stem, e.g. paper3)
# HYPERION_ID=paper3

ALPACA_KEY=
ALPACA_SECRET=
ALPACA_API=https://paper-api.alpaca.markets/v2

JINGHONG_REDIS_PATH=/run/goblin-core/goblin.sock
JINGHONG_ORDER_CHANNEL=ACCOUNT:ORDER:paper3
JINGHONG_STATUS_CHANNEL=ACCOUNT:STATUS:paper3
JINGHONG_HTTP_BIND=0.0.0.0
JINGHONG_HTTP_PORT=8768
JINGHONG_ALPACA_CHANNEL=ACCOUNT:ALPACA:paper3
JINGHONG_ALPACA_LOG=/var/log/jinghong/paper3-alpaca.jsonl
